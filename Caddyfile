{
	admin off
	persist_config off
	auto_https off
}

:{$PORT:8080} {
	root * /app/build
	encode zstd gzip

	@waifu path /waifu /waifu/
	header @waifu X-Robots-Tag "noindex"

	# Vite puts a content hash in their names, so a name never gets new content.
	# Only existing files, a 404 shouldn't stick for a year
	handle /assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# route keeps this order, so the header sees the path after the SPA fallback
	handle {
		route {
			try_files {path} /index.html
			# The page names its build's assets, so the browser has to check for a newer one
			header /index.html Cache-Control "no-cache"
			file_server
		}
	}
}
