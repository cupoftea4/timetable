{
	admin off
	persist_config off
	auto_https off
}

:{$PORT:8080} {
	root * /app/build
	encode zstd gzip

	@waifu path /waifu /waifu/
	header @waifu X-Robots-Tag "noindex"

	# Vite puts a content hash in their names, so a name never gets new content.
	# Only existing files, a 404 shouldn't stick for a year
	handle /assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
