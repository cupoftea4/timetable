{
  "name": "timetable",
  "version": "2.7.0",
  "homepage": "/",
  "private": true,
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-datalist-input": "^3.2.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "react-toastify": "^11.1.0",
    "serve": "^14.2.5"
  },
  "scripts": {
    "start": "serve -s build -p ${PORT:-3000}",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "dev": "env-cmd -f dev.env vite --host",
    "build:prod": "tsc && env-cmd -f .env vite build",
    "build:hope": "tsc && env-cmd -f hope.env vite build --mode development",
    "lint": "biome lint"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "env-cmd": "^11.0.0",
    "lefthook": "^2.1.12",
    "postcss": "^8.4.47",
    "sass": "^1.55.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
